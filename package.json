{
  "name": "proengram",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit --incremental false",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "health": "repnix check --details",
    "health:audit": "repnix audit",
    "health:plan": "repnix setup --plan --format json",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "health:dead-code": "knip",
    "health:duplication": "jscpd src"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "jose": "^6.2.17",
    "next": "^16.4.1",
    "panel-frame-ui": "^0.2.5",
    "pg": "^8.21.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ssh2": "1.17.0",
    "server-only": "^0.0.1",
    "ui-preview-kit": "^0.1.3",
    "ws": "8.22.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "^24.19.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "1.15.6",
    "@types/ws": "8.18.1",
    "jscpd": "^5.4.3",
    "knip": "^6.45.1",
    "repnix": "^1.1.0",
    "typescript": "^6.0.3"
  },
  "license": "MIT"
}
