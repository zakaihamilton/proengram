# ProEngram app origin and cryptographic OAuth state signing key.
PROENGRAM_ORIGIN=http://localhost:3000
PROENGRAM_COOKIE_SECRET=replace-with-at-least-32-random-bytes

# Perminister product and organization. Create separate app clients:
# 1) Dashboard client: standard OIDC sign-in, no MCP resource profile.
# 2) MCP resource client: configure the exact MCP resource URI and scopes below.
PERMINISTER_URL=https://www.perminister.com
PERMINISTER_ISSUER=https://www.perminister.com
PERMINISTER_PRODUCT_ID=proengram
PERMINISTER_ORGANIZATION_ID=
PERMINISTER_DASHBOARD_CLIENT_ID=
PERMINISTER_DASHBOARD_CLIENT_SECRET=
PERMINISTER_MCP_CLIENT_ID=
PERMINISTER_MCP_CLIENT_SECRET=
PERMINISTER_MCP_RESOURCE_URI=http://localhost:3000/mcp
PERMINISTER_MCP_SCOPES=brain:read policy:read result:save knowledge:propose
PROENGRAM_MCP_ALLOWED_ORIGINS=https://chatgpt.com,https://claude.ai

# Nanogres-managed PostgreSQL connection strings. Keep both server-only.
DATABASE_URL=
MIGRATION_DATABASE_URL=

# GitHub App integration for company Markdown. Grant repository Contents and Pull Requests access.
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=
GITHUB_DEFAULT_BRANCH=main
