# Local development defaults. Production uses the same variable names with
# production URLs and a separate production client pair in Vercel.
PROENGRAM_ORIGIN=http://localhost:3000
PROENGRAM_COOKIE_SECRET=replace-with-at-least-32-random-bytes

# Perminister product. Create a dashboard + MCP client pair
# for each environment. Keep the local and production MCP clients separate:
# each one is restricted to that environment's exact resource URI.
PERMINISTER_URL=https://www.perminister.com
PERMINISTER_ISSUER=https://www.perminister.com
PERMINISTER_PRODUCT_ID=proengram
PERMINISTER_DASHBOARD_CLIENT_ID=
PERMINISTER_DASHBOARD_CLIENT_SECRET=
PERMINISTER_MCP_CLIENT_ID=
PERMINISTER_MCP_CLIENT_SECRET=
PERMINISTER_MCP_RESOURCE_URI=http://localhost:3000/mcp
PERMINISTER_MCP_SCOPES=brain:read policy:read result:save knowledge:propose
PROENGRAM_MCP_ALLOWED_ORIGINS=https://chatgpt.com,https://claude.ai

# Passwordless Nanogres connection settings. Vercel supplies VERCEL_OIDC_TOKEN.
NANOGRES_ORGANIZATION_ID=
NANOGRES_DATABASE=proengram
NANOGRES_RUNTIME_ROLE=
NANOGRES_MIGRATION_ROLE=
NANOGRES_MIGRATION_OWNER_ROLE=
NANOGRES_IDENTITY_URL=https://nanogres.vercel.app/api/workload-identity

# GitHub App credentials shared by organization-specific repository connections.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
# Legacy single-organization migration inputs. Keep old deployment values through the first
# `pnpm db:migrate`; the migration copies them into the existing organization's settings.
# PERMINISTER_ORGANIZATION_ID=
# GITHUB_INSTALLATION_ID=
# GITHUB_REPO_OWNER=
# GITHUB_REPO_NAME=
# GITHUB_DEFAULT_BRANCH=main
